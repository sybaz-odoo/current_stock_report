<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_current_stock_report_wizard" model="ir.ui.view">
    <field name="name">current.stock.report.wizard.form</field>
    <field name="model">current.stock.report.wizard</field>
    <field name="arch" type="xml">
        <form string="Current Stock Report Wizard">
            <group col="4">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="product_category_ids" widget="many2many_tags" options="{'no_create_edit': True, 'no_create': True}"/>
                <field name="product_tag_ids" widget="many2many_tags" options="{'no_create_edit': True, 'no_create': True}"/>
                <field name="exclusive_loc_ids" widget="many2many_tags" options="{'no_create_edit': True, 'no_create': True}"/>
            </group>
            <footer>
                <button string="Generate Report" type="object" name="generate_report_htm" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>


    <record id="action_current_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Current Stock Report</field>
        <field name="res_model">current.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_current_stock_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_current_stock_report"
              name="Current Stock Report"
              sequence="400"
              action="action_current_stock_report_wizard"
              parent="stock.menu_warehouse_report"/>
</odoo>
